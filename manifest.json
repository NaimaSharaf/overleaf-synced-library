{
  "manifest_version": 3,
  "name": "Overleaf Synced Library",
  "version": "2.5.1",
  "minimum_chrome_version": "114",
  "description": "Save Overleaf evidence or Websurfing links and screenshots to a shared local library.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "clipboardWrite",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.overleaf.com/*",
    "https://overleaf.com/*"
  ],
  "action": {
    "default_title": "Open local capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://overleaf.com/project/*"
      ],
      "js": [
        "extract.js",
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://overleaf.com/project/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
